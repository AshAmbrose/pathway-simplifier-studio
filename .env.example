# Copy to .env.local (gitignored) and fill in. Get a key at https://aistudio.google.com/apikey (see README). Read only on the server; never sent to the browser.
GEMINI_API_KEY=
# The extraction model id.
EXTRACT_MODEL=gemini-4-hydrogen
# Daily AI budget in US dollars (summed from data/ai-ledger.jsonl by local day).
DAILY_USD=5

# Only for the shared demo (npm run demo): put these in .env.demo, which adds to .env.local. See docs/hosting.md.
# The password for every page (the browser asks for it; any user name works).
DEMO_PASSWORD=
# Where the demo keeps its runs and AI log, apart from your own (data/ is gitignored).
DATA_DIR=data/demo
# Most figure readings a day, whatever they cost (unset means no cap; DAILY_USD still applies).
# MAX_CALLS_PER_DAY=20
# Quick read: LOW makes the model think less. About 3x faster, but it asks fewer questions and may settle an
# unclear arrow without asking. Leave unset for the careful read. Works in .env.local or .env.demo.
# EXTRACT_THINKING=LOW
